 }
+
+/* ====================== CAPABILITY REGISTER + WORK REGISTRY ====================== */
+.capability-matrix {
+  display: grid;
+  gap: 1rem;
+  margin-top: 2rem;
+}
+
+.capability-row {
+  display: grid;
+  grid-template-columns: minmax(200px, 240px) minmax(0, 1fr) minmax(180px, 220px);
+  gap: 1.75rem;
+  align-items: start;
+  padding: 1.75rem;
+  border-radius: var(--radius-lg);
+  transition: border-color 180ms ease, transform 180ms ease;
+}
+
+.capability-row.is-active {
+  border-color: rgba(125, 211, 252, 0.55);
+}
+
+.capability-domain {
+  display: flex;
+  flex-direction: column;
+  gap: 0.4rem;
+  align-items: flex-start;
+  text-align: left;
+  background: transparent;
+  border: 0;
+  padding: 0;
+  cursor: pointer;
+  color: inherit;
+  font: inherit;
+}
+
+.capability-domain-name {
+  font-size: 1.05rem;
+  font-weight: 600;
+  line-height: 1.3;
+  color: var(--text);
+}
+
+.capability-filter-hint {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
+  font-size: 0.68rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--muted);
+  transition: color 160ms ease;
+}
+
+.capability-domain:hover .capability-filter-hint,
+.capability-row.is-active .capability-filter-hint {
+  color: var(--accent-strong);
+}
+
+.capability-domain:focus-visible {
+  outline: 2px solid var(--accent-strong);
+  outline-offset: 6px;
+  border-radius: 6px;
+}
+
+.capability-summary {
+  margin: 0 0 1rem;
+  color: var(--muted-strong);
+  font-size: 0.98rem;
+  line-height: 1.6;
+}
+
+.capability-signals {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
+  gap: 0.35rem 1.25rem;
+}
+
+.capability-signals li {
+  position: relative;
+  padding-left: 0.9rem;
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
+  font-size: 0.82rem;
+  line-height: 1.7;
+  color: var(--muted-strong);
+}
+
+.capability-signals li::before {
+  content: '';
+  position: absolute;
+  left: 0;
+  top: 0.72em;
+  width: 4px;
+  height: 1px;
+  background: var(--accent);
+}
+
+.capability-provenance {
+  display: flex;
+  flex-direction: column;
+  gap: 0.55rem;
+  padding-left: 1.5rem;
+  border-left: 1px solid var(--panel-border);
+}
+
+.capability-provenance-label {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
+  font-size: 0.66rem;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+.capability-provenance-items {
+  display: flex;
+  flex-direction: column;
+  gap: 0.3rem;
+  font-size: 0.85rem;
+  color: var(--muted-strong);
+}
+
+.capability-provenance-items a {
+  color: var(--accent);
+  border-bottom: 1px solid transparent;
+  width: fit-content;
+}
+
+.capability-provenance-items a:hover {
+  border-bottom-color: var(--accent);
+}
+
+.registry-card {
+  display: flex;
+  flex-direction: column;
+  gap: 0.75rem;
+}
+
+.registry-status {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
+  font-size: 0.66rem;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  width: fit-content;
+  padding: 0.25rem 0.6rem;
+  border-radius: 999px;
+  border: 1px solid var(--panel-border);
+}
+
+.registry-status--shipped {
+  color: var(--success);
+  border-color: rgba(52, 211, 153, 0.4);
+}
+
+.registry-status--in-development {
+  color: var(--accent-warm);
+  border-color: rgba(245, 158, 11, 0.4);
+}
+
+.registry-stack {
+  list-style: none;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.4rem;
+  margin: 0;
+  padding: 0;
+}
+
+.registry-stack li {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
+  font-size: 0.7rem;
+  color: var(--muted);
+  border: 1px solid var(--panel-border);
+  border-radius: 6px;
+  padding: 0.2rem 0.45rem;
+}
+
+.registry-links {
+  display: flex;
+  gap: 1rem;
+  margin-top: auto;
+  padding-top: 0.5rem;
+}
+
+.registry-links a {
+  font-size: 0.85rem;
+  color: var(--accent);
+  border-bottom: 1px solid rgba(125, 211, 252, 0.3);
+}
+
+.registry-links a:hover {
+  border-bottom-color: var(--accent);
+}
+
+@media (max-width: 960px) {
+  .capability-row {
+    grid-template-columns: 1fr;
+    gap: 1.25rem;
+  }
+
+  .capability-provenance {
+    padding-left: 0;
+    padding-top: 1rem;
+    border-left: 0;
+    border-top: 1px solid var(--panel-border);
+  }
+
+  .capability-provenance-items {
+    flex-direction: row;
+    flex-wrap: wrap;
+    gap: 0.75rem;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .capability-row {
+    transition: none;
+  }
+}
