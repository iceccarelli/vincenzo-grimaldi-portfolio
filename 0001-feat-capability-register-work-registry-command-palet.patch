+}
+
+.palette-footer {
+  display: flex;
+  gap: 1.25rem;
+  padding: 0.7rem 1.25rem;
+  border-top: 1px solid var(--panel-border);
+  font-size: 0.72rem;
+  color: var(--muted);
+}
+
+.palette-footer span {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.3rem;
+}
