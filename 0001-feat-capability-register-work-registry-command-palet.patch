+/* ====================== MEGA MENU ====================== */
+.megamenu {
+  position: static;
+}
+
+.megamenu-trigger {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.35rem;
+  background: transparent;
+  border: 0;
+  padding: 0;
+  color: var(--muted-strong);
+  font: inherit;
+  font-size: 0.9rem;
