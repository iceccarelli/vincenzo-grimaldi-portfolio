+.palette-backdrop {
+  position: fixed;
+  inset: 0;
+  z-index: 200;
+  background: rgba(3, 8, 18, 0.72);
+  backdrop-filter: blur(6px);
+  display: flex;
+  justify-content: center;
+  padding: 12vh 1rem 1rem;
+}
+
+.palette {
+  width: min(640px, 100%);
+  max-height: 70vh;
+  display: flex;
+  flex-direction: column;
+  border-radius: var(--radius-lg);
+  border: 1px solid rgba(125, 211, 252, 0.28);
+  background: var(--bg-elevated);
+  box-shadow: var(--shadow);
+  overflow: hidden;
+}
+
+.palette-input {
+  width: 100%;
+  border: 0;
+  border-bottom: 1px solid var(--panel-border);
+  background: transparent;
+  color: var(--text);
+  padding: 1.1rem 1.25rem;
+  font-size: 1rem;
+  outline: none;
+}
+
+.palette-input::placeholder {
+  color: var(--muted);
+}
+
+.palette-results {
+  overflow-y: auto;
+  padding: 0.5rem;
+}
+
+.palette-group {
+  margin: 0.75rem 0 0.35rem;
+  padding: 0 0.75rem;
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
+  font-size: 0.64rem;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+.palette-item {
+  display: flex;
+  align-items: baseline;
+  gap: 0.75rem;
+  width: 100%;
+  text-align: left;
+  padding: 0.6rem 0.75rem;
+  border: 0;
+  border-radius: 10px;
+  background: transparent;
+  color: var(--muted-strong);
+  cursor: pointer;
+  font: inherit;
+}
+
+.palette-item[data-active='true'] {
+  background: rgba(56, 189, 248, 0.12);
+  color: var(--text);
+}
+
+.palette-item-label {
+  font-size: 0.94rem;
+}
+
+.palette-item-hint {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
+  font-size: 0.72rem;
+  color: var(--muted);
+  margin-left: auto;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  max-width: 55%;
+}
+
+.palette-item-external {
+  color: var(--accent);
+  font-size: 0.8rem;
+}
+
+.palette-empty {
+  padding: 1.5rem 0.75rem;
+  color: var(--muted);
+  font-size: 0.9rem;
+}
+
+.palette-empty code {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
+  color: var(--accent);
+}
+
+.palette-footer {
+  display: flex;
+  gap: 1.25rem;
+  padding: 0.7rem 1.25rem;
+  border-top: 1px solid var(--panel-border);
+  font-size: 0.72rem;
+  color: var(--muted);
+}
+
+.palette-footer span {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.3rem;
+}
+
+@media (max-width: 720px) {
+  .palette-trigger span {
+    display: none;
+  }
+  .palette-item-hint {
+    display: none;
+  }
+  .palette-backdrop {
+    padding-top: 6vh;
+  }
+}
+
+/* ====================== MEGA MENU ====================== */
+.megamenu {
+  position: static;
+}
+
+.megamenu-trigger {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.35rem;
+  background: transparent;
+  border: 0;
+  padding: 0;
+  color: var(--muted-strong);
+  font: inherit;
+  font-size: 0.9rem;
+  cursor: pointer;
+  transition: color 160ms ease;
+}
+
+.megamenu-trigger:hover,
+.megamenu-trigger[aria-expanded='true'] {
+  color: var(--text);
+}
+
+.megamenu-caret {
+  font-size: 0.6rem;
+  transition: transform 160ms ease;
+}
+
+.megamenu-caret.is-open {
+  transform: rotate(180deg);
+}
+
+.megamenu-panel {
+  position: absolute;
+  left: 0;
+  right: 0;
+  top: 100%;
+  z-index: 90;
+  display: grid;
+  grid-template-columns: 1.1fr 1fr 1.2fr;
+  gap: 2.5rem;
+  padding: 2rem clamp(1.25rem, 5vw, 3rem);
+  border-top: 1px solid var(--panel-border);
+  border-bottom: 1px solid var(--panel-border);
+  background: var(--bg-elevated);
+  backdrop-filter: blur(18px);
+  box-shadow: var(--shadow);
+}
+
+.megamenu-heading {
+  margin: 0 0 0.9rem;
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
+  font-size: 0.64rem;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+.megamenu-column ul {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  gap: 0.15rem;
+}
+
+.megamenu-column li a {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 1rem;
+  padding: 0.45rem 0.6rem;
+  border-radius: 8px;
+  color: var(--muted-strong);
+  font-size: 0.9rem;
+  transition: background 140ms ease, color 140ms ease;
+}
+
+.megamenu-column li a:hover {
+  background: rgba(56, 189, 248, 0.1);
+  color: var(--text);
+}
+
+.megamenu-column li a small {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
+  font-size: 0.68rem;
+  color: var(--muted);
+}
+
+.megamenu-feature {
+  display: block;
+  padding: 1rem;
+  margin-bottom: 0.75rem;
+  border: 1px solid var(--panel-border);
+  border-radius: var(--radius-md);
+  background: var(--bg-soft);
+  transition: border-color 160ms ease;
+}
+
+.megamenu-feature:hover {
+  border-color: rgba(125, 211, 252, 0.5);
+}
+
+.megamenu-feature-tag {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
+  font-size: 0.62rem;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--success);
+}
+
+.megamenu-feature strong {
+  display: block;
+  margin-top: 0.3rem;
+  color: var(--text);
+  font-size: 0.98rem;
+}
+
+.megamenu-feature p {
+  margin: 0.35rem 0 0;
+  font-size: 0.82rem;
+  line-height: 1.55;
+  color: var(--muted);
+}
+
+@media (max-width: 1024px) {
+  .megamenu {
+    display: none;
+  }
+}
