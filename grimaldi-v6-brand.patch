 app/components/Header.tsx     |   3 ++-
 app/components/SiteFooter.tsx |   3 ++-
 app/icon.png                  | Bin 42005 -> 0 bytes
 app/icon.svg                  |  26 +++++++++++++++++++++
 6 files changed, 76 insertions(+), 2 deletions(-)
 create mode 100644 app/components/BrandMark.tsx
 delete mode 100644 app/icon.png
 create mode 100644 app/icon.svg

