+.ask-chip:hover {
+  border-color: #7a52f4;
+  background: rgba(122, 82, 244, 0.07);
+}
+
+.ask-msg {
+  max-width: 92%;
+  border-radius: 14px;
+  padding: 0.65rem 0.85rem;
+  font-size: 0.9rem;
+  line-height: 1.5;
+}
+
+.ask-msg-visitor {
+  align-self: flex-end;
+  background: var(--ink);
+  color: #ffffff;
+  border-bottom-right-radius: 4px;
+}
+
+.ask-msg-guide {
+  align-self: flex-start;
+  background: var(--page-bg);
+  border: 1px solid var(--border);
+  border-bottom-left-radius: 4px;
+}
+
+.ask-msg-guide p {
+  margin: 0;
+  color: var(--text);
+}
+
+.ask-links {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.45rem;
+  margin-top: 0.6rem;
+}
+
+.ask-links a {
+  font-size: 0.8rem;
+  font-weight: 600;
+  color: var(--link);
+  border: 1px solid var(--border);
+  border-radius: 999px;
+  padding: 0.28rem 0.7rem;
+  text-decoration: none;
+}
+
+.ask-links a:hover {
+  border-color: var(--link);
+}
+
+.ask-input-row {
+  display: flex;
+  gap: 0.5rem;
+  padding: 0.75rem 1.1rem;
+  border-top: 1px solid var(--border);
+  background: var(--page-bg);
+}
+
+.ask-input-row input {
+  flex: 1;
+  border: 1px solid var(--border-strong);
+  border-radius: 12px;
+  padding: 0.55rem 0.85rem;
+  font-size: 0.9rem;
+  font-family: inherit;
+  color: var(--text);
+  background: var(--page-bg);
+}
+
+.ask-input-row input:focus {
+  outline: 2px solid rgba(122, 82, 244, 0.5);
+  outline-offset: 1px;
+  border-color: transparent;
+}
+
+.ask-input-row button {
+  width: 40px;
+  border: none;
+  border-radius: 12px;
+  background: var(--ask-gradient);
+  color: #ffffff;
+  font-size: 1.05rem;
+  cursor: pointer;
+}
+
+.ask-foot {
+  padding: 0.55rem 1.1rem 0.75rem;
+  font-size: 0.72rem;
+  line-height: 1.4;
+  color: var(--muted);
+  background: var(--page-bg);
+}
+
+@media (max-width: 560px) {
+  .ask-panel {
+    right: 0.75rem;
+    bottom: 5.2rem;
+  }
+  .ask-launcher {
+    right: 0.75rem;
+    bottom: 0.9rem;
+  }
+  .story-card {
+    flex-basis: 82vw;
+  }
+}
