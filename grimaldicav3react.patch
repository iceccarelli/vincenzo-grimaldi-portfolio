+/* ============================================================================
+   GRIMALDI.CA — warm editorial identity
+   Function: humanize the network. Identity: paper and evening light —
+   cream ground, serif display voice, terracotta-rose accents, generous air.
+   Same geometry family as the network; the softest member of it, on purpose.
+   ========================================================================== */
+
+:root {
+  --paper: #faf6ef;
+  --paper-2: #f3ecdf;
+  --card: #ffffff;
+  --border: #e7ddcc;
+  --border-strong: #d5c7b0;
+  --ink: #2b2420;
+  --text-2: #5c5248;
+  --muted: #8a7d6e;
+  --terra: #c0563a;
+  --rose: #c86b8f;
+  --gold: #b98a2f;
+  --sheet-r: 40px;
+  --r: 16px;
+  --max: 1240px;
+  --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, 'Times New Roman', serif;
+}
+
+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; }
+body {
+  margin: 0;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
+  background: var(--paper);
+  color: var(--ink);
+  -webkit-font-smoothing: antialiased;
+}
+a { color: inherit; text-decoration: none; }
+::selection { background: rgba(192, 86, 58, 0.2); }
+
+/* ── Chrome ─────────────────────────────────────────────────────────── */
+.utility { background: var(--ink); color: #f6efe4; height: 40px; display: flex; align-items: center; }
+.utility-in { width: 100%; max-width: var(--max); margin: 0 auto; padding: 0 1.5rem; display: flex; justify-content: flex-end; align-items: center; gap: 1.2rem; font-size: .78rem; }
+.utility a { opacity: .9; }
+.utility a:hover { opacity: 1; text-decoration: underline; }
+.lang { display: inline-flex; gap: .15rem; padding: .15rem; border: 1px solid rgba(246, 239, 228, 0.4); border-radius: 999px; }
+.lang button { border: 0; background: transparent; color: rgba(246, 239, 228, 0.85); font-size: .72rem; font-weight: 600; padding: .22rem .55rem; border-radius: 999px; cursor: pointer; }
+.lang button.on { background: #f6efe4; color: var(--ink); }
+
+.nav { position: sticky; top: 0; background: rgba(250, 246, 239, 0.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); min-height: 64px; display: flex; align-items: center; z-index: 9; }
+.nav-in { width: 100%; max-width: var(--max); margin: 0 auto; padding: .6rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
+.brand { display: inline-flex; align-items: center; gap: .65rem; }
+.brand b { font-size: .98rem; font-family: var(--serif); }
+.brand small { display: block; font-size: .72rem; color: var(--muted); }
+.nav-links { display: flex; align-items: center; gap: 1.3rem; font-size: .9rem; font-weight: 500; color: var(--text-2); }
+.nav-links a:hover { color: var(--terra); }
+.pill { padding: .5rem 1.2rem; border-radius: 999px; background: var(--terra); color: #fff8ef; font-weight: 650; font-size: .85rem; white-space: nowrap; }
+.pill:hover { filter: brightness(0.94); }
+
+/* ── Hero: the generative sky ───────────────────────────────────────── */
+.hero { position: relative; padding: 4.5rem 1.5rem 7.5rem; overflow: hidden; }
+.sky { position: absolute; inset: 0; width: 100%; height: 100%; }
+.hero-in { position: relative; max-width: var(--max); margin: 0 auto; display: flex; gap: 2.5rem; align-items: center; }
+.hero-card { background: rgba(255, 253, 248, 0.88); backdrop-filter: blur(6px); border-radius: 20px; padding: 2.5rem; max-width: 640px; box-shadow: 0 8px 30px rgba(43, 36, 32, 0.18); }
+.kicker { font-size: .74rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--terra); }
+h1 { font-family: var(--serif); font-size: clamp(2.1rem, 3.8vw, 3rem); line-height: 1.12; margin: .65rem 0 1rem; font-weight: 600; letter-spacing: -.01em; }
+.lead { color: var(--text-2); line-height: 1.75; margin: 0 0 1.6rem; font-size: 1.02rem; }
+.cta-row { display: flex; flex-wrap: wrap; gap: .85rem; }
+.btn { display: inline-flex; align-items: center; gap: .5rem; padding: .74rem 1.5rem; border-radius: 999px; font-size: .92rem; font-weight: 650; border: 1px solid transparent; }
+.btn-dark { background: var(--ink); color: #f6efe4; }
+.btn-dark:hover { background: #3a322c; }
+.btn-line { background: rgba(255, 253, 248, 0.7); color: var(--ink); border-color: var(--ink); }
+.btn-line:hover { background: #fff; }
+.hero-portrait { flex: none; width: 280px; height: 280px; border-radius: 999px; overflow: hidden; border: 6px solid rgba(255, 253, 248, 0.9); box-shadow: 0 12px 40px rgba(43, 36, 32, 0.3); }
+.hero-portrait img { width: 100%; height: 100%; object-fit: cover; display: block; }
+
+/* ── Sheet + sections ───────────────────────────────────────────────── */
+.sheet { background: var(--paper); border-radius: var(--sheet-r) var(--sheet-r) 0 0; margin-top: -3.5rem; position: relative; }
+.section { max-width: var(--max); margin: 0 auto; padding: 4rem 1.5rem; }
+h2 { font-family: var(--serif); font-size: clamp(1.55rem, 2.6vw, 2.15rem); font-weight: 600; letter-spacing: -.01em; margin: .4rem 0 .5rem; }
+.intro { color: var(--text-2); line-height: 1.75; max-width: 700px; margin: 0 0 2rem; }
+
+.grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
+.card { background: var(--card); border: 1px solid var(--border); border-radius: var(--r); padding: 1.6rem 1.5rem; display: flex; flex-direction: column; gap: .6rem; box-shadow: 0 1px 2px rgba(43, 36, 32, 0.04); }
+.card .tag { font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--rose); }
+.card h3 { margin: 0; font-size: 1.08rem; font-family: var(--serif); }
+.card p { margin: 0; color: var(--text-2); font-size: .93rem; line-height: 1.7; flex: 1; }
+.card-link { transition: transform .15s ease, box-shadow .15s ease; }
+.card-link:hover { transform: translateY(-3px); box-shadow: 0 6px 24px rgba(43, 36, 32, 0.12); }
+.card .cta { font-size: .88rem; font-weight: 650; color: var(--terra); }
+.status { display: inline-flex; align-items: center; gap: .5rem; font-size: .84rem; font-weight: 600; color: var(--text-2); }
+.dot { width: 8px; height: 8px; border-radius: 999px; background: var(--gold); flex: none; }
+
+/* ── Journey timeline ───────────────────────────────────────────────── */
+.journey { list-style: none; margin: 0; padding: 0; position: relative; max-width: 760px; }
+.journey::before { content: ''; position: absolute; left: 56px; top: 12px; bottom: 12px; width: 2px; background: linear-gradient(180deg, var(--rose), var(--terra), var(--gold)); border-radius: 2px; }
+.journey-item { display: flex; gap: 2rem; padding: 1.1rem 0; position: relative; }
+.journey-year { flex: none; width: 112px; text-align: right; padding-right: 2rem; font-family: var(--serif); font-weight: 700; color: var(--terra); font-size: 1.02rem; position: relative; }
+.journey-year::after { content: ''; position: absolute; right: -6px; top: .35rem; width: 12px; height: 12px; border-radius: 999px; background: var(--paper); border: 3px solid var(--terra); }
+.journey-item h3 { margin: 0 0 .3rem; font-family: var(--serif); font-size: 1.12rem; }
+.journey-item p { margin: 0; color: var(--text-2); line-height: 1.7; font-size: .94rem; }
+
+/* ── Now steps ──────────────────────────────────────────────────────── */
+.steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; counter-reset: step; }
+.step { background: var(--paper-2); border: 1px solid var(--border); border-radius: var(--r); padding: 1.6rem 1.5rem; }
+.step::before { counter-increment: step; content: counter(step, decimal-leading-zero); display: block; font-family: var(--serif); font-size: 1.5rem; font-weight: 700; color: var(--rose); margin-bottom: .6rem; }
+.step h3 { margin: 0 0 .4rem; font-size: 1.05rem; font-family: var(--serif); }
+.step p { margin: 0; color: var(--text-2); font-size: .92rem; line-height: 1.7; }
+
+/* ── Banner + footer ────────────────────────────────────────────────── */
+.banner { background: linear-gradient(95deg, #f6cfae, #f3b98b); border-radius: var(--r); padding: 2rem 2.25rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem; }
+.banner h2 { font-size: 1.25rem; margin: 0 0 .25rem; }
+.banner p { margin: 0; color: #6b4a33; font-size: .9rem; }
+
+footer { background: var(--ink); color: #f6efe4; border-radius: var(--sheet-r) var(--sheet-r) 0 0; margin-top: 3rem; }
+.foot { max-width: var(--max); margin: 0 auto; padding: 3rem 1.5rem 2rem; }
+.foot-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem; margin-bottom: 2.5rem; }
+.foot h4 { margin: 0 0 1rem; font-size: .95rem; font-family: var(--serif); }
+.foot a { display: block; color: rgba(246, 239, 228, 0.78); font-size: .88rem; margin-bottom: .7rem; }
+.foot a:hover { color: #fff; text-decoration: underline; }
+.foot p { color: rgba(246, 239, 228, 0.78); font-size: .9rem; line-height: 1.65; }
+.foot-brand { display: flex; align-items: center; gap: .7rem; margin-bottom: 1rem; }
+.foot-brand b { font-family: var(--serif); }
+.legal { border-top: 1px solid rgba(246, 239, 228, 0.2); padding-top: 1.25rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; color: rgba(246, 239, 228, 0.6); font-size: .82rem; }
+
+@media (max-width: 980px) {
+  .utility-in { justify-content: center; flex-wrap: wrap; row-gap: .3rem; }
+  .nav-links { display: none; }
+  .hero-in { flex-direction: column-reverse; align-items: flex-start; }
+  .hero-portrait { width: 200px; height: 200px; }
+  .grid, .steps, .foot-grid { grid-template-columns: 1fr; }
+  .journey::before { left: 12px; }
+  .journey-item { flex-direction: column; gap: .4rem; padding-left: 2.4rem; }
+  .journey-year { width: auto; text-align: left; padding-right: 0; }
+  .journey-year::after { left: -2.05rem; right: auto; }
+  .sheet, footer { border-radius: 28px 28px 0 0; }
+  .hero { padding: 2.5rem 1.25rem 6rem; }
+}
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+}
