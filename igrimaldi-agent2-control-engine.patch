--- a/app/globals.css
+++ b/app/globals.css
@@ -896,3 +896,498 @@ code {
     display: none;
   }
 }
+
+/* ============================================================================
+   Control engine — registers, tables, pipelines, badges.
+   Same paper, same ink. Colour is redundant with text everywhere; the word
+   is the badge. No motion.
+   ========================================================================== */
+
+.doc-wide {
+  --max: 1080px;
+}
+
+.mandate {
+  max-width: 28ch;
+}
+
+.h-note {
+  font-family: var(--sans);
+  font-weight: 400;
+  font-size: 0.85rem;
+  margin-left: 0.5rem;
+}
+
+.sub-h {
+  font-family: var(--sans);
+  font-size: 0.82rem;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--muted);
+  margin: 1.5rem 0 0.5rem;
+}
+
+.muted {
+  color: var(--muted);
+}
+
+.src {
+  font-size: 0.8rem;
+}
+
+.empty {
+  color: var(--muted);
+  border-left: 2px solid var(--line);
+  padding-left: 0.9rem;
+  max-width: 60ch;
+}
+
+.hdr-sub {
+  display: block;
+  font-family: var(--mono);
+  font-size: 0.7rem;
+  font-weight: 400;
+  letter-spacing: 0.04em;
+  color: var(--muted);
+  margin-top: 0.1rem;
+}
+
+/* pipelines */
+
+.pipe {
+  list-style: none;
+  margin: 1rem 0;
+  padding: 0;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.4rem 0;
+}
+
+.pipe li {
+  display: flex;
+  align-items: center;
+}
+
+.pipe li + li::before {
+  content: '→';
+  color: var(--muted);
+  margin: 0 0.55rem;
+  font-family: var(--mono);
+}
+
+.pipe-stage {
+  font-family: var(--mono);
+  font-size: 0.82rem;
+  letter-spacing: 0.06em;
+  padding: 0.3rem 0.6rem;
+  border: 1px solid var(--line);
+  background: var(--panel);
+  white-space: nowrap;
+}
+
+.pipe-compact .pipe-stage {
+  font-size: 0.74rem;
+  padding: 0.2rem 0.45rem;
+}
+
+.pipe-det .pipe-stage {
+  border-color: var(--ink);
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.pipe-det .pipe-stage::after {
+  content: ' ·det';
+  opacity: 0.7;
+}
+
+/* status badges — six words, one shape */
+
+.st {
+  display: inline-block;
+  font-family: var(--mono);
+  font-size: 0.7rem;
+  letter-spacing: 0.08em;
+  line-height: 1;
+  padding: 0.3rem 0.45rem;
+  border: 1px solid var(--line);
+  background: var(--panel);
+  color: var(--ink);
+  vertical-align: middle;
+  white-space: nowrap;
+}
+
+.st-core {
+  border-color: var(--ink);
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.st-module {
+  border-color: var(--rhine);
+  color: var(--rhine);
+}
+
+.st-research {
+  border-style: dashed;
+}
+
+.st-internal {
+  color: var(--muted);
+}
+
+.st-experiment {
+  border-color: var(--fault);
+  color: var(--fault);
+}
+
+.st-archive {
+  color: var(--muted);
+  text-decoration: line-through;
+}
+
+/* grades */
+
+.grade {
+  font-family: var(--mono);
+  font-size: 0.85rem;
+}
+
+.grade-high {
+  font-weight: 600;
+}
+
+.grade-none {
+  color: var(--muted);
+}
+
+/* status board */
+
+.board {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
+  gap: 1px;
+  margin: 1rem 0 0;
+  padding: 0;
+  background: var(--line);
+  border: 1px solid var(--line);
+}
+
+.board-cell {
+  background: var(--panel);
+  padding: 0.9rem 1rem;
+}
+
+.board dt {
+  font-size: 0.78rem;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+.board dd {
+  margin: 0.25rem 0 0;
+  font-family: var(--serif);
+  font-size: 1.6rem;
+  line-height: 1.1;
+  font-variant-numeric: tabular-nums;
+}
+
+/* tables */
+
+.tbl-wrap {
+  overflow-x: auto;
+  margin: 1rem 0;
+  border-top: 1px solid var(--ink);
+  border-bottom: 1px solid var(--line);
+}
+
+.tbl {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 0.92rem;
+  line-height: 1.45;
+  min-width: 640px;
+}
+
+.tbl caption {
+  text-align: left;
+  font-size: 0.82rem;
+  color: var(--muted);
+  padding: 0.5rem 0;
+  caption-side: top;
+}
+
+.tbl th,
+.tbl td {
+  text-align: left;
+  vertical-align: top;
+  padding: 0.65rem 0.75rem 0.65rem 0;
+  border-bottom: 1px solid var(--line);
+}
+
+.tbl thead th {
+  font-size: 0.75rem;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--muted);
+  font-weight: 600;
+  border-bottom: 1px solid var(--ink);
+}
+
+.tbl tbody th {
+  font-weight: 600;
+}
+
+.tbl tbody tr:last-child th,
