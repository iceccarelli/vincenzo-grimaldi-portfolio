+      { x: 0.85, y: 0.65 }
+    ];
+
+    const edges = [
+      [0, 1], [1, 2], [2, 3], [3, 0], [1, 4], [4, 5], [5, 6], [6, 0], [2, 6]
+    ];
+
+    const particles = edges.map(([startIdx, endIdx]) => ({
+      startIdx,
+      endIdx,
+      progress: Math.random(),
+      speed: 0.005 + Math.random() * 0.01,
+    }));
+
+    const resize = () => {
+      canvas.width = canvas.offsetWidth;
+      canvas.height = 110;
